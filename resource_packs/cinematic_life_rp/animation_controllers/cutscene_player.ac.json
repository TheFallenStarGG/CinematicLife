{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.cutscene_player": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "waking": "query.variant == 1" }
          ]
        },
        "waking": {
          "animations": ["wake_up"],
          "transitions": [
            { "default": "query.all_animations_finished" }
          ]
        }
      }
    }
  }
}
